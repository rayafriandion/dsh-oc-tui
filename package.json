    "@deepseek-ai/dsh-user-approval": { "optional": true },
    "@deepseek-ai/dsh-user-questions": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": false },
    "@dsh-std/command": { "optional": true },
    "@dsh-std/presentation": { "optional": true },
    "@dsh-std/sdk": { "optional": true },
    "@dsh-std/ui": { "optional": true }
  },
  "dsh": {
